# Copy to .env (never commit it). All keys are optional: without them Atlas
# runs on clearly-labelled SAMPLE prices and an offline (rule-based) chat.

# Database (SQLite file by default)
ATLAS_DB_URL=sqlite:///data/atlas.db

# Market data
EODHD_API_KEY=
FINNHUB_API_KEY=
# auto = real adapters where a key exists, else sample; sample = force sample data
ATLAS_PRICE_SOURCE=auto

# Claude (Atlas chat). Leave empty to use the offline responder.
ANTHROPIC_API_KEY=
ATLAS_MODEL=claude-opus-5-5
ATLAS_EFFORT=medium
# Specialists (Market Watch) use Claude for headline judgment when a key is set.
ATLAS_WORKER_MODEL=claude-opus-5-5
ATLAS_LLM_SPECIALISTS=1

# Where approved trades go. Only "paper" can place orders in phase 1.
ATLAS_TRADING_BROKER=paper

# Hard override: 1 forces the kill switch on regardless of the database.
ATLAS_KILL_SWITCH=0
